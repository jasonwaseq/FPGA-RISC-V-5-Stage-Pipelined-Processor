# iCEBreaker v1.1a pin constraints (iCE40UP5K-SG48)

# 12 MHz oscillator
set_io CLK 35

# User button and red LED on the main board (active low).
# The green LED (pin 37) is left unused: driving it disturbs the SPI flash.
set_io BTN_N  10
set_io LEDR_N 11

# UART through the FTDI bridge (channel B)
set_io RX 6
set_io TX 9

# Configuration flash (W25Q128JV)
set_io FLASH_SCK 15
set_io FLASH_SSB 16
set_io FLASH_IO0 14
set_io FLASH_IO1 17
set_io FLASH_IO2 12
set_io FLASH_IO3 13

# Break-off PMOD (PMOD2): five LEDs and three buttons
set_io -nowarn LED1 26
set_io -nowarn LED2 27
set_io -nowarn LED3 25
set_io -nowarn LED4 23
set_io -nowarn LED5 21
set_io -nowarn BTN1 20
set_io -nowarn BTN2 19
set_io -nowarn BTN3 18
